@model Heimevernet.Web.Models.ViewModels.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot password";
}

<h1>Forgot password</h1>
<p>Enter your email address and we will send a reset link if an account exists.</p>
<form asp-action="ForgotPassword" method="post" asp-antiforgery="true" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Send reset link</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
