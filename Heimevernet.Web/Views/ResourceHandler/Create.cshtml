@using Heimevernet.Web.Models.ViewModels.Resource
@model ResourceViewModel
@{
    ViewData["Title"] = "Ny Ressurs";
}


@if (Model == null)
{
    <form asp-controller="ResourceHandler" asp-action="Create" method="post">
        <div>
            <label asp-for="Name"></label>
            <input asp-for="Name" />
        </div>
        <div>
            <label asp-for="Description"></label>
            <input asp-for="Description" />
        </div>
        <div>
            <label asp-for="Type"></label>
            <input asp-for="Type" />
        </div>
        <button type="submit">Create</button>
    </form>
}
else
{

    <div>
        Gratulerer du har opprettet en ny ressurs!
        <h1>@Model.Name</h1>
        <p>@Model.Description</p>
        <p>Type: @Model.Type</p>
    </div>
}
